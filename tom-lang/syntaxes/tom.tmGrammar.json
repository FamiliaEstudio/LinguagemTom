{
    "scopeName": "source.tom",
    "patterns": [
        {
            "comment": "1. Strings literais (l'Texto')",
            "match": "(l')([^']*)(')",
            "captures": {
                "1": {
                    "name": "keyword.operator.tom"
                },
                "2": {
                    "name": "string.quoted.single.tom"
                },
                "3": {
                    "name": "keyword.operator.tom"
                }
            }
        },
        {
            "comment": "2. Comandos (Somar, GpuDisp, GpuFence...) - SEM \\b no final para aceitar colado",
            "match": "\\b(Somarl|Somar|Subtr|Multi|Divid|GerarTxt|Aloc|Liber|ZonaDef|ZonaRst|ZonaMatar|EscopoIni|EscopoFim|DefStk|DefVar|SetVar|LerEntrada|DefTxt|SetTxt|SomarTxt|DefZn|DefKernel|FimDef|DefBudgetFrame|DefBudgetSistema|DefPrioridade|DefPrioridad|GpuBufCriar|GpuEnv|GpuIdObt|GpuLer|GpuEscr|GpuDisp|GpuDispAsync|GpuRec|GpuApresentar|GpuFence|AguardarGpu|SEProv|SEImpr)",
            "name": "keyword.control.tom"
        },
        {
            "comment": "3. Tipo + Bits (Fl64, In32). Ambos como Storage/Type (Azul/Ciano)",
            "match": "(In|Fl|Sd|Ud)(32|64|128)",
            "captures": {
                "1": {
                    "name": "storage.type.tom"
                },
                "2": {
                    "name": "storage.type.tom"
                }
            }
        },
        {
            "comment": "4. Hexadecimais (0xFF...)",
            "match": "(@|0x)([0-9A-Fa-f]+)",
            "captures": {
                "1": {
                    "name": "keyword.operator.tom"
                },
                "2": {
                    "name": "constant.numeric.hex.tom"
                }
            }
        },
        {
            "comment": "5. Variável + Número (x1000). Garante separação de cores.",
            "match": "([xyz])([0-9]+)",
            "captures": {
                "1": {
                    "name": "variable.parameter.tom"
                },
                "2": {
                    "name": "constant.numeric.tom"
                }
            }
        },
        {
            "comment": "6. Variáveis soltas (x, y) que sobraram no meio.",
            "match": "[xyz]",
            "name": "variable.parameter.tom"
        },
        {
            "comment": "7. Tipos Especiais (Vec4, Heap, etc)",
            "match": "\\b(Vec4|Vec8|Esc|Hp|Stk|Zn|FB\\d+C|FB\\d+U|FB\\d+|I8|UT)\\b",
            "name": "storage.type.tom"
        }
    ]
}
