Importar[l'tom/geometria']
DefConstFl64xCANVAS_ZOOM_MINy0.25
DefConstFl64xCANVAS_ZOOM_MAXy4.0
DefRegistroxCanvasCamera
PropFl64xx
PropFl64xy
PropFl64xzoom
PropFl64xponteiroX
PropFl64xponteiroY
PropBlxarrastando
FimDef

DefFuncaoxCanvasCriar[]yRegistro<CanvasCamera>
DefVarRegistro<CanvasCamera>xCamerayPadrao
SetVarFl64xCamera.zoomy1.0
Retornarx@Camera
FimFuncao

DefFuncaoxCanvasConteudoX[Registro<CanvasCamera>xCamera,Fl64xTela]yFl64
CompararMaiorxyFl64x@Camera.zoomy0.0
Exigir[@ULTIMO]
SubtrxyFl64x@Telay@Camera.x
DividxyFl64x@ULTIMOy@Camera.zoom
Retornarx@ULTIMO
FimFuncao
DefFuncaoxCanvasConteudoY[Registro<CanvasCamera>xCamera,Fl64xTela]yFl64
CompararMaiorxyFl64x@Camera.zoomy0.0
Exigir[@ULTIMO]
SubtrxyFl64x@Telay@Camera.y
DividxyFl64x@ULTIMOy@Camera.zoom
Retornarx@ULTIMO
FimFuncao
DefFuncaoxCanvasTelaX[Registro<CanvasCamera>xCamera,Fl64xConteudo]yFl64
MultixyFl64x@Conteudoy@Camera.zoom
SomarxyFl64x@ULTIMOy@Camera.x
Retornarx@ULTIMO
FimFuncao
DefFuncaoxCanvasTelaY[Registro<CanvasCamera>xCamera,Fl64xConteudo]yFl64
MultixyFl64x@Conteudoy@Camera.zoom
SomarxyFl64x@ULTIMOy@Camera.y
Retornarx@ULTIMO
FimFuncao

// Calcula tudo antes de publicar a câmera; o ponto sob o cursor não se move.
DefFuncaoxCanvasZoom[RefRegistro<CanvasCamera>xCamera,Fl64xFator,Fl64xCursorX,Fl64xCursorY]yVazio
CompararMaiorxyFl64x@Fatory0.0
Exigir[@ULTIMO]
ChamarxCanvasConteudoX[@Camera,@CursorX]
DefVarFl64xConteudoXy@ULTIMO
ChamarxCanvasConteudoY[@Camera,@CursorY]
DefVarFl64xConteudoYy@ULTIMO
MultixyFl64x@Camera.zoomy@Fator
DefVarFl64xZoomy@ULTIMO
CompararMenorxyFl64x@Zoomy@CANVAS_ZOOM_MIN
Sex@ULTIMO
SetVarFl64xZoomy@CANVAS_ZOOM_MIN
FimSe
CompararMaiorxyFl64x@Zoomy@CANVAS_ZOOM_MAX
Sex@ULTIMO
SetVarFl64xZoomy@CANVAS_ZOOM_MAX
FimSe
MultixyFl64x@ConteudoXy@Zoom
SubtrxyFl64x@CursorXy@ULTIMO
DefVarFl64xXy@ULTIMO
MultixyFl64x@ConteudoYy@Zoom
SubtrxyFl64x@CursorYy@ULTIMO
DefVarFl64xYy@ULTIMO
SetVarFl64xCamera.xy@X
SetVarFl64xCamera.yy@Y
SetVarFl64xCamera.zoomy@Zoom
FimFuncao

DefFuncaoxCanvasDeslocar[RefRegistro<CanvasCamera>xCamera,Fl64xDX,Fl64xDY]yVazio
SomarxyFl64x@Camera.xy@DX
DefVarFl64xXy@ULTIMO
SomarxyFl64x@Camera.yy@DY
DefVarFl64xYy@ULTIMO
SetVarFl64xCamera.xy@X
SetVarFl64xCamera.yy@Y
FimFuncao
DefFuncaoxCanvasArrasteIniciar[RefRegistro<CanvasCamera>xCamera,Fl64xX,Fl64xY]yVazio
SetVarFl64xCamera.ponteiroXy@X
SetVarFl64xCamera.ponteiroYy@Y
SetVarBlxCamera.arrastandoyVerdadeiro
FimFuncao
DefFuncaoxCanvasArrasteMover[RefRegistro<CanvasCamera>xCamera,Fl64xX,Fl64xY]yVazio
Sex@Camera.arrastando
SubtrxyFl64x@Xy@Camera.ponteiroX
DefVarFl64xDXy@ULTIMO
SubtrxyFl64x@Yy@Camera.ponteiroY
ChamarxCanvasDeslocar[@Camera,@DX,@ULTIMO]
SetVarFl64xCamera.ponteiroXy@X
SetVarFl64xCamera.ponteiroYy@Y
FimSe
FimFuncao
// A aplicação chama ao soltar qualquer botão ou perder o foco.
DefFuncaoxCanvasArrasteTerminar[RefRegistro<CanvasCamera>xCamera]yVazio
SetVarBlxCamera.arrastandoyFalso
FimFuncao
