{
  "Soma Inteiro": {
    "prefix": "SomarIn",
    "body": [
      "SomarxyIn${1|Sd,Ud|}${2|32,64|}x${3:10}y${4:20}"
    ],
    "description": "Soma inteira com verificação de overflow."
  },
  "Soma Float": {
    "prefix": "SomarFl",
    "body": [
      "SomarxyFl${1|32,64|}x${2:0.1}y${3:0.2}"
    ],
    "description": "Soma em ponto flutuante."
  },
  "Variável inteira": {
    "prefix": "DefVarIn",
    "body": [
      "DefVarIn${1|Sd,Ud|}${2|32,64|}x${3:valor}y${4:0}"
    ],
    "description": "Declara variável com tipo explícito."
  },
  "Variável float": {
    "prefix": "DefVarFl",
    "body": [
      "DefVarFl${1|32,64|}x${2:valor}y${3:0.0}"
    ],
    "description": "Declara variável de ponto flutuante."
  },
  "Atribuição": {
    "prefix": "SetVar",
    "body": [
      "SetVarIn${1|Sd,Ud|}${2|32,64|}x${3:valor}y${4:0}"
    ],
    "description": "Atualiza uma variável já declarada com o mesmo tipo."
  },
  "Entrada numérica": {
    "prefix": "LerEntrada",
    "body": [
      "LerEntradaIn${1|Sd,Ud|}${2|32,64|}x${3:valor}"
    ],
    "description": "Lê um inteiro, verificando sintaxe, sinal e faixa."
  },
  "Texto": {
    "prefix": "DefTxt",
    "body": [
      "DefTxtx${1:mensagem}yl'${2:Olá, Tom!}'"
    ],
    "description": "Define texto literal UTF-8."
  },
  "Imprimir literal": {
    "prefix": "GerarTxt",
    "body": [
      "GerarTxtxl'${1:Olá, Tom!}\\n'"
    ],
    "description": "Imprime conteúdo literal, incluindo sinais de porcentagem."
  },
  "Buffer verificado": {
    "prefix": "StrSafe",
    "body": [
      "DefStkFB64Cx${1:mensagem}yl'${2:Texto}'"
    ],
    "description": "Buffer UTF-8 de 64 bytes incluindo NUL, mutável em execução e liberado ao sair do bloco."
  },
  "Escopo": {
    "prefix": "Escopo",
    "body": [
      "EscopoInix${1:Bloco}",
      "$0",
      "EscopoFimx${1:Bloco}"
    ],
    "description": "Escopo léxico, sem repetição implícita."
  },
  "Condicional": {
    "prefix": "SeMaior",
    "body": [
      "EscopoInix${1:Condicao}",
      "SeMaiorxyInSd32x${2:10}y${3:0}",
      "GerarTxtxl'${4:Verdadeiro}\\n'",
      "EscopoFimx${1:Condicao}"
    ],
    "description": "Executa o restante do escopo se x for maior que y."
  },
  "Defer": {
    "prefix": "Defer",
    "body": [
      "DeferGerarTxtxl'${1:Escopo encerrado.}\\n'"
    ],
    "description": "Dentro de um escopo, registra ação de saída em ordem inversa."
  },
  "Decimal": {
    "prefix": "DefVarDc34",
    "body": [
      "DefVarDc34x${1:valor}y${2:0.1}"
    ],
    "description": "Decimal exato, com 34 dígitos significativos."
  },
  "Booleano": {
    "prefix": "DefVarBl",
    "body": [
      "DefVarBlx${1:executar}y${2|Verdadeiro,Falso|}"
    ],
    "description": "Booleano."
  },
  "Se / Senao": {
    "prefix": "Se",
    "body": [
      "Sex${1:Verdadeiro}",
      "${2:GerarTxtxl'Sim'}",
      "Senao",
      "${3:GerarTxtxl'Não'}",
      "FimSe"
    ],
    "description": "Condição Bl com ramos e escopos independentes."
  },
  "Enquanto": {
    "prefix": "Enquanto",
    "body": [
      "DefVarBlx${1:executar}yVerdadeiro",
      "Enquantox@${1:executar}",
      "SetVarBlx${1:executar}yFalso",
      "FimEnquanto"
    ],
    "description": "Laço que reinicializa declarações e limpa cada passagem."
  },
  "Funcao CPU": {
    "prefix": "DefFuncao",
    "body": [
      "DefFuncaox${1:SomarValores}[Dc34xA,Dc34xB]yDc34",
      "SomarxyDc34x@Ay@B",
      "Retornarx@ULTIMO",
      "FimFuncao",
      "Chamarx${1:SomarValores}[0.1,0.2]"
    ],
    "description": "Função CPU sem recursão, com parâmetros e retorno tipados."
  },
  "Capturar erro": {
    "prefix": "Tentar",
    "body": [
      "Tentar",
      "${1:GerarTxtxl'Executando'}",
      "Capturarx${2:Erro}",
      "ErroMensagemx${2:Erro}",
      "GerarTxtUltimo",
      "FimTentar"
    ],
    "description": "Captura falhas de execução depois de executar Defer."
  },
  "Copiar buffer": {
    "prefix": "CopiarTxt",
    "body": [
      "CopiarTxt[@${1:Destino},l'${2:Texto}']"
    ],
    "description": "Substituição atômica de buffer UTF-8."
  },
  "Janela SDL": {
    "prefix": "JanelaCriar",
    "body": [
      "DefRecursox${1:Janela}yJanelaCriar[l'${2:Aplicação Tom}',480,640]"
    ],
    "description": "Janela SDL3 redimensionável com liberação lexical."
  },
  "Constante": {
    "prefix": "DefConst",
    "body": [
      "DefConstInSd32x${1:VALOR}y${2:42}"
    ],
    "description": "Constante tipada, sem mutação."
  },
  "Importar biblioteca": {
    "prefix": "Importar",
    "body": [
      "Importar[l'${1:tom/musica}']"
    ],
    "description": "Importa definições sem executar inicialização."
  },
  "Relogio": {
    "prefix": "TempoAgoraNs",
    "body": [
      "TempoAgoraNs[]",
      "DefVarInSd64x${1:Agora}y@ULTIMO"
    ],
    "description": "Captura o relógio monotônico em nanossegundos."
  },
  "Sorteador": {
    "prefix": "SorteadorCriar",
    "body": [
      "DefRecursox${1:R}ySorteadorCriar[42,54]",
      "SortearInteiro[@${1:R},${2:7}]"
    ],
    "description": "Sorteio reproduzível no intervalo [0, limite)."
  },
  "Audio agendado": {
    "prefix": "AudioAgendarTom",
    "body": [
      "DefRecursox${1:A}yAudioCriar[]",
      "AudioAgendarTom[@${1:A},0,440.0,0.1,500000000,0]",
      "AudioPausar[@${1:A},Falso]"
    ],
    "description": "Agenda um tom; mantenha o escopo aberto durante a reprodução."
  },
  "SOA emprestada": {
    "prefix": "RefSOA",
    "body": [
      "DefStructSOAx${1:Item}",
      "PropBlxativo",
      "FimDef",
      "DefFuncaox${2:Ativar}[RefSOA<${1:Item}>xItens]yVazio",
      "SetVarBlxItens@0.ativoyVerdadeiro",
      "FimFuncao"
    ],
    "description": "Função com empréstimo mutável de uma coleção com limites verificados."
  },
  "Visual preparado": {
    "prefix": "VisualTextoCriar",
    "body": [
      "DefRecursox${1:Visual}yVisualTextoCriar[@${2:Janela},@${3:Fonte},l'${4:Texto}']",
      "DesenharVisual[@${2:Janela},@${1:Visual},24.0,48.0,4294967295]"
    ],
    "description": "Prepara o texto uma vez; X/Y indicam a origem e a linha de base."
  },
  "Enumeração": {
    "prefix": "DefEnum",
    "body": [
      "DefEnumx${1:Fase}",
      "ItemxPronta",
      "ItemxPausada",
      "FimDef",
      "DefVarEnum<${1:Fase}>x${2:Atual}y@${1:Fase}.Pronta"
    ],
    "description": "Enumeração nominal; igualdade apenas entre valores do mesmo tipo."
  },
  "Registro": {
    "prefix": "DefRegistro",
    "body": [
      "DefRegistrox${1:Sessao}",
      "PropInSd64xorigemNs",
      "PropBlxpausada",
      "FimDef",
      "DefVarRegistro<${1:Sessao}>x${2:Estado}yPadrao"
    ],
    "description": "Estado por valor; campos aninhados e Dc34 independentes."
  },
  "Registro emprestado": {
    "prefix": "RefRegistro",
    "body": [
      "DefFuncaox${1:Pausar}[RefRegistro<${2:Sessao}>xEstado]yVazio",
      "SetVarBlxEstado.pausadayVerdadeiro",
      "FimFuncao"
    ],
    "description": "Mutação explícita do registro do chamador durante a chamada."
  },
  "Para intervalo": {
    "prefix": "Para",
    "body": [
      "Parax${1:I}[${2:0},${3:10},${4:1}]",
      "$0",
      "FimPara"
    ],
    "description": "Índice InSd64 somente leitura; fim exclusivo, limites avaliados uma vez."
  },
  "Para índices SOA": {
    "prefix": "ParaIndiceSOA",
    "body": [
      "ParaIndiceSOAx${1:I}[@${2:Itens}]",
      "$0",
      "FimPara"
    ],
    "description": "Percorre o comprimento verificado da coleção; cada passagem executa sua limpeza."
  },
  "Documento JSON": {
    "prefix": "JsonCriar",
    "body": [
      "DefRecursox${1:Documento}yJsonCriar[1048576]",
      "JsonDefinirInSd64[@${1:Documento},l'/versao',1]"
    ],
    "description": "Documento lexical com orçamento de memória explícito."
  },
  "Diretório do usuário": {
    "prefix": "DadosUsuarioCriar",
    "body": [
      "DefRecursox${1:Dados}yDadosUsuarioCriar[l'${2:Organizacao}',l'${3:Aplicacao}']"
    ],
    "description": "Arquivos relativos ao diretório de preferências da aplicação."
  },
  "Visual transformado": {
    "prefix": "DesenharVisualTransformado",
    "body": [
      "DesenharVisualTransformado[@${1:Janela},@${2:Visual},${3:100.0},${4:100.0},${5:1.0},${6:1.0},${7:0.0},${8:4294967295}]"
    ],
    "description": "Escala e rotação pela origem/linha de base, reutilizando a textura."
  },
  "Painel arredondado": {
    "prefix": "DesenharRetanguloArredondado",
    "body": [
      "DesenharRetanguloArredondado[@${1:Janela},${2:40.0},${3:40.0},${4:300.0},${5:180.0},${6:16.0},${7:4294967295},${8:4294967295}]"
    ],
    "description": "Cantos suaves e gradiente vertical; repita a cor para preenchimento sólido."
  },
  "Animação por tempo": {
    "prefix": "AnimacaoInterpolar",
    "body": [
      "Importar[l'tom/animacao']",
      "ChamarxAnimacaoInterpolar[${1:0.0},${2:1.0},@${3:Inicio},${4:450000000},@${5:Agora},@AnimacaoCurva.Suave]",
      "DefVarFl64x${6:Valor}y@ULTIMO"
    ],
    "description": "Curva calculada pelo horário, independente dos quadros apresentados."
  },
  "Canal local de mensagens": {
    "prefix": "CanalMensagensAbrir",
    "body": [
      "DefRecursox${1:Canal}yCanalMensagensAbrir[1048576,8]",
      "DefStkFB1048577Cx${2:Mensagem}yl''",
      "CanalMensagensConsultar[@${1:Canal},@${2:Mensagem}]",
      "Sex@ULTIMO",
      "CanalMensagensEnviar[@${1:Canal},@${2:Mensagem}]",
      "FimSe"
    ],
    "description": "Consulta sem bloquear; envia UTF-8 por pipes locais. O processo pai fornece stdin/stdout."
  },
  "RaizQuadradaFl64": {
    "prefix": "RaizQuadradaFl64",
    "body": [
      "RaizQuadradaFl64[${1:9.0}]"
    ],
    "description": "Raiz real verificada; negativos lançam erro Tom."
  },
  "HipotenusaFl64": {
    "prefix": "HipotenusaFl64",
    "body": [
      "HipotenusaFl64[${1:3.0},${2:4.0}]"
    ],
    "description": "Distância estável com verificação de valores finitos."
  },
  "JanelaEventosRolagem": {
    "prefix": "JanelaEventosRolagem",
    "body": [
      "JanelaEventosRolagem[@${1:Janela},Verdadeiro]"
    ],
    "description": "Ativa rolagem precisa nesta janela."
  },
  "EventoCampoFl64": {
    "prefix": "EventoCampoFl64",
    "body": [
      "EventoCampoFl64[@${1:Evento},${2|1,2,12,13|}]"
    ],
    "description": "Ponteiro X/Y ou rolagem X/Y em coordenadas lógicas Fl64."
  },
  "Canvas e câmera": {
    "prefix": "CanvasCriar",
    "body": [
      "Importar[l'tom/canvas']",
      "ChamarxCanvasCriar[]",
      "DefVarRegistro<CanvasCamera>x${1:Camera}y@ULTIMO"
    ],
    "description": "Câmera independente do relógio e do compilador."
  },
  "Texto dinâmico": {
    "prefix": "TextoCriar",
    "body": [
      "DefRecursox${1:Texto}yTextoCriar[l'${2:}',67108864]"
    ],
    "description": "Texto UTF-8 com crescimento automático até o limite, incluindo NUL."
  },
  "SQLite banco e consulta": {
    "prefix": "SQLiteAbrir",
    "body": [
      "Importar[l'tom/sqlite']",
      "DefRecursox${1:Banco}ySQLiteAbrir[l'${2:acervo.sqlite}']",
      "DefRecursox${3:Consulta}ySQLitePreparar[@${1:Banco},l'SELECT ?1']",
      "SQLiteVincularTexto[@${3:Consulta},1,l'${4:Olá}']",
      "SQLiteAvancar[@${3:Consulta}]",
      "Sex@ULTIMO",
      "DefRecursox${5:Resultado}yTextoCriar[l'',67108864]",
      "SQLiteColunaTexto[@${3:Consulta},0,@${5:Resultado}]",
      "GerarTxtx${5:Resultado}",
      "FimSe"
    ],
    "description": "Consulta parametrizada com resultado UTF-8 e limpeza automática."
  },
  "Documento com histórico": {
    "prefix": "DocumentoCriar",
    "body": [
      "DefRecursox${1:Documento}yDocumentoCriar[l'${2:}',67108864,134217728]"
    ],
    "description": "Documento UTF-8 com seleção por grafemas, estilos e histórico limitado."
  },
  "Editor reutilizável": {
    "prefix": "EditorCriar",
    "body": [
      "Importar[l'tom/editor']",
      "DefRecursox${1:Janela}yJanelaCriar[l'Editor',960,720]",
      "DefRecursox${2:Fonte}yFonteCarregar[12]",
      "DefRecursox${3:Documento}yDocumentoCriar[l'',67108864,134217728]",
      "DefRecursox${4:Editor}yEditorCriar[@${1:Janela},@${3:Documento},@${2:Fonte}]",
      "EditorArea[@${4:Editor},24,24,912,672]",
      "EditorFoco[@${4:Editor},Verdadeiro]"
    ],
    "description": "Apresentação SDL reutilizável, com fontes privadas e documento independente."
  },
  "Persistência do documento": {
    "prefix": "PersistenciaDocumentoAbrir",
    "body": [
      "Importar[l'tom/editor_sqlite']",
      "DefRecursox${1:Documento}yDocumentoCriar[l'',67108864,134217728]",
      "DefRecursox${2:Armazenamento}yPersistenciaDocumentoAbrir[l'${3:documentos.sqlite}',1,@${1:Documento}]"
    ],
    "description": "Abre a versão confirmada; consulte a recuperação pendente antes de gravar."
  }
}
