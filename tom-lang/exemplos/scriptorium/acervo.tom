ChamarxSQLiteExecutar[@Banco,l'CREATE TRIGGER textos_inserir AFTER INSERT ON textos BEGIN INSERT INTO pesquisa(rowid,titulo,conteudo) VALUES(new.id,new.titulo,new.conteudo); END']
ChamarxSQLiteExecutar[@Banco,l'CREATE TRIGGER textos_apagar AFTER DELETE ON textos BEGIN INSERT INTO pesquisa(pesquisa,rowid,titulo,conteudo) VALUES(\'delete\',old.id,old.titulo,old.conteudo); END']
ChamarxSQLiteExecutar[@Banco,l'CREATE TRIGGER textos_alterar AFTER UPDATE ON textos BEGIN INSERT INTO pesquisa(pesquisa,rowid,titulo,conteudo) VALUES(\'delete\',old.id,old.titulo,old.conteudo); INSERT INTO pesquisa(rowid,titulo,conteudo) VALUES(new.id,new.titulo,new.conteudo); END']
