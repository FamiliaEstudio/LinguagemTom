// Gerado por scripts/generate-planilha.js a partir de planilha.sql e planilha-sugestoes.sql.
Importar[l'tom/sqlite']
DefFuncaoxPlanilhaCarregarSQL[RefBancoSQLitexBanco,TxtxEntrada]yVazio
DefRecursoxTransacaoySQLiteTransacaoIniciar[@Banco]
DefRecursoxQ0ySQLitePreparar[@Banco,l'-- Staging is temporary and belongs to this application connection, never to the corpus schema.\nCREATE TEMP TABLE IF NOT EXISTS sc_planilha_meta(hash TEXT, origem TEXT, aba TEXT, erro TEXT DEFAULT \'\')']
SQLiteAvancar[@Q0]
DefRecursoxQ1ySQLitePreparar[@Banco,l'CREATE TEMP TABLE IF NOT EXISTS sc_planilha_celulas(linha INTEGER, coluna INTEGER, referencia TEXT, tipo TEXT, valor TEXT, unidades_utf16 INTEGER, PRIMARY KEY(linha,coluna))']
SQLiteAvancar[@Q1]
DefRecursoxQ2ySQLitePreparar[@Banco,l'CREATE TEMP TABLE IF NOT EXISTS sc_planilha_campos(coluna INTEGER PRIMARY KEY, nome TEXT, parte INTEGER)']
SQLiteAvancar[@Q2]
DefRecursoxQ3ySQLitePreparar[@Banco,l'CREATE TEMP TABLE IF NOT EXISTS sc_planilha_itens(linha INTEGER PRIMARY KEY, texto TEXT, dados TEXT, contexto TEXT DEFAULT \'\', erro TEXT DEFAULT \'\', selecionada INTEGER DEFAULT 0, confirmada INTEGER DEFAULT 0, anterior INTEGER DEFAULT 0, sugestoes INTEGER DEFAULT 0)']
SQLiteAvancar[@Q3]
DefRecursoxQ4ySQLitePreparar[@Banco,l'CREATE TEMP TABLE IF NOT EXISTS sc_planilha_falhas(linha INTEGER, coluna INTEGER, mensagem TEXT)']
SQLiteAvancar[@Q4]
DefRecursoxQ5ySQLitePreparar[@Banco,l'CREATE TEMP TABLE IF NOT EXISTS sc_planilha_listas(linha INTEGER, campo TEXT, valor TEXT)']
SQLiteAvancar[@Q5]
DefRecursoxQ6ySQLitePreparar[@Banco,l'DELETE FROM sc_planilha_meta']
SQLiteAvancar[@Q6]
DefRecursoxQ7ySQLitePreparar[@Banco,l'DELETE FROM sc_planilha_celulas']
SQLiteAvancar[@Q7]
DefRecursoxQ8ySQLitePreparar[@Banco,l'DELETE FROM sc_planilha_campos']
SQLiteAvancar[@Q8]
DefRecursoxQ9ySQLitePreparar[@Banco,l'DELETE FROM sc_planilha_itens']
SQLiteAvancar[@Q9]
DefRecursoxQ10ySQLitePreparar[@Banco,l'DELETE FROM sc_planilha_falhas']
SQLiteAvancar[@Q10]
DefRecursoxQ11ySQLitePreparar[@Banco,l'DELETE FROM sc_planilha_listas']
SQLiteAvancar[@Q11]
DefRecursoxQ12ySQLitePreparar[@Banco,l'INSERT INTO sc_planilha_meta(hash,origem,aba) SELECT json_extract(?1,\'$.hash\'),json_extract(?1,\'$.origem\'),json_extract(?1,\'$.aba\')']
SQLiteVincularTexto[@Q12,1,@Entrada]
SQLiteAvancar[@Q12]
DefRecursoxQ13ySQLitePreparar[@Banco,l'INSERT INTO sc_planilha_celulas SELECT json_extract(r.value,\'$.linha\'),json_extract(c.value,\'$.coluna\'),json_extract(c.value,\'$.referencia\'),json_extract(c.value,\'$.tipo\'),json_extract(c.value,\'$.valor\'),json_extract(c.value,\'$.unidades_utf16\') FROM json_each(?1,\'$.linhas\') r,json_each(r.value,\'$.celulas\') c']
SQLiteVincularTexto[@Q13,1,@Entrada]
SQLiteAvancar[@Q13]
DefRecursoxQ14ySQLitePreparar[@Banco,l'INSERT INTO sc_planilha_campos\nSELECT coluna,valor,CASE WHEN valor=\'texto\' THEN 1 WHEN substr(valor,1,6)=\'texto_\' AND CAST(substr(valor,7) AS INTEGER) BETWEEN 2 AND 16384 AND valor=\'texto_\'||CAST(substr(valor,7) AS INTEGER) THEN CAST(substr(valor,7) AS INTEGER) ELSE 0 END\nFROM sc_planilha_celulas WHERE linha=1 AND valor<>\'\'']
SQLiteAvancar[@Q14]
DefRecursoxQ15ySQLitePreparar[@Banco,l'INSERT INTO sc_planilha_falhas SELECT 1,c.coluna,\'Cabeçalho deve ser texto.\' FROM sc_planilha_celulas c WHERE linha=1 AND tipo NOT IN(\'texto\',\'vazio\')']
SQLiteAvancar[@Q15]
DefRecursoxQ16ySQLitePreparar[@Banco,l'INSERT INTO sc_planilha_falhas SELECT 1,coluna,\'Cabeçalho desconhecido: \'||nome FROM sc_planilha_campos WHERE parte=0 AND nome NOT IN(\'titulo\',\'incipit\',\'corpus\',\'genero\',\'subgenero\',\'estado\',\'idioma\',\'autor\',\'persona\',\'certeza\',\'composicao\',\'publicacao\',\'tags\',\'colecoes\',\'justificativa\',\'notas\',\'arquivo_origem\',\'localizacao_origem\',\'corpus_sugerido\',\'genero_sugerido\',\'tags_sugeridas\',\'justificativa_ia\')']
SQLiteAvancar[@Q16]
DefRecursoxQ17ySQLitePreparar[@Banco,l'INSERT INTO sc_planilha_falhas SELECT 1,coluna,\'Cabeçalho repetido: \'||nome FROM sc_planilha_campos WHERE nome IN(SELECT nome FROM sc_planilha_campos GROUP BY nome HAVING count(*)>1)']
SQLiteAvancar[@Q17]
DefRecursoxQ18ySQLitePreparar[@Banco,l'INSERT INTO sc_planilha_falhas SELECT 1,0,\'Falta o cabeçalho obrigatório texto na linha 1.\' WHERE NOT EXISTS(SELECT 1 FROM sc_planilha_campos WHERE nome=\'texto\')']
SQLiteAvancar[@Q18]
DefRecursoxQ19ySQLitePreparar[@Banco,l'UPDATE sc_planilha_meta SET erro=coalesce((SELECT group_concat(\'Linha 1, coluna \'||coalesce(c.referencia,\'?\')||\': \'||f.mensagem,char(10)) FROM sc_planilha_falhas f LEFT JOIN sc_planilha_celulas c ON c.linha=1 AND c.coluna=f.coluna WHERE f.linha=1),\'\')']
SQLiteAvancar[@Q19]
DefRecursoxQ20ySQLitePreparar[@Banco,l'INSERT INTO sc_planilha_itens(linha,texto,dados)\nSELECT c.linha,coalesce(group_concat(c.valor,\'\' ORDER BY h.parte) FILTER(WHERE h.parte>0),\'\'),\n coalesce(json_group_object(h.nome,c.valor) FILTER(WHERE h.parte=0),\'{}\')\nFROM sc_planilha_celulas c LEFT JOIN sc_planilha_campos h USING(coluna)\nWHERE c.linha>1 GROUP BY c.linha HAVING sum(c.valor<>\'\' OR c.tipo=\'formula\')>0']
SQLiteAvancar[@Q20]
DefRecursoxQ21ySQLitePreparar[@Banco,l'INSERT INTO sc_planilha_falhas\nSELECT c.linha,c.coluna,CASE WHEN h.nome IS NULL THEN \'Célula preenchida sem cabeçalho.\' WHEN c.tipo=\'formula\' THEN \'Fórmula não é aceita; substitua por texto literal.\' ELSE \'Valor deve ser do tipo texto; configure a célula como Texto e digite novamente.\' END\nFROM sc_planilha_celulas c LEFT JOIN sc_planilha_campos h USING(coluna)\nWHERE c.linha>1 AND (c.valor<>\'\' OR c.tipo=\'formula\') AND (h.nome IS NULL OR c.tipo NOT IN(\'texto\',\'vazio\'))']
SQLiteAvancar[@Q21]
DefRecursoxQ22ySQLitePreparar[@Banco,l'INSERT INTO sc_planilha_falhas SELECT linha,coluna,\'Célula excede 32.767 caracteres ou 253 quebras de linha; use colunas de continuação.\' FROM sc_planilha_celulas WHERE linha>1 AND (unidades_utf16>32767 OR length(replace(replace(valor,char(13)||char(10),char(10)),char(13),char(10)))-length(replace(replace(valor,char(13),\'\'),char(10),\'\'))>253)']
SQLiteAvancar[@Q22]
DefRecursoxQ23ySQLitePreparar[@Banco,l'INSERT INTO sc_planilha_falhas SELECT linha,(SELECT coluna FROM sc_planilha_campos WHERE nome=\'texto\' LIMIT 1),\'O texto da obra está vazio.\' FROM sc_planilha_itens WHERE texto=\'\'']
SQLiteAvancar[@Q23]
DefRecursoxQ24ySQLitePreparar[@Banco,l'INSERT INTO sc_planilha_falhas\nSELECT c.linha,c.coluna,\'Valor inválido para \'||h.nome||\': \'||c.valor FROM sc_planilha_celulas c JOIN sc_planilha_campos h USING(coluna)\nWHERE c.linha>1 AND c.valor<>\'\' AND (\n (h.nome IN(\'corpus\',\'corpus_sugerido\') AND c.valor NOT IN(SELECT nome FROM corpora)) OR\n (h.nome=\'estado\' AND c.valor NOT IN(\'Fragmento\',\'Rascunho\',\'Concluído\',\'Abandonado\',\'Publicado\')) OR\n (h.nome=\'certeza\' AND c.valor NOT IN(\'Confirmado\',\'Provável\',\'Possível\',\'Indeterminado\')))']
SQLiteAvancar[@Q24]
DefRecursoxQ25ySQLitePreparar[@Banco,l'WITH RECURSIVE partes(linha,campo,resto,item) AS (\n SELECT c.linha,h.nome,c.valor||\';\',\'\' FROM sc_planilha_celulas c JOIN sc_planilha_campos h USING(coluna) WHERE c.linha>1 AND h.nome IN(\'tags\',\'colecoes\',\'tags_sugeridas\')\n UNION ALL SELECT linha,campo,substr(resto,instr(resto,\';\')+1),trim(substr(resto,1,instr(resto,\';\')-1)) FROM partes WHERE resto<>\'\'\n)\nINSERT INTO sc_planilha_listas SELECT DISTINCT linha,campo,item FROM partes WHERE item<>\'\'']
SQLiteAvancar[@Q25]
DefRecursoxQ26ySQLitePreparar[@Banco,l'WITH datas AS (\n SELECT c.linha,h.nome,c.valor FROM sc_planilha_celulas c JOIN sc_planilha_campos h USING(coluna) WHERE c.linha>1 AND h.nome IN(\'composicao\',\'publicacao\')\n), extremos AS (\n SELECT *,substr(valor,1,10) AS a,substr(valor,12,10) AS b FROM datas\n), normal AS (\n SELECT linha,nome,CASE WHEN length(a)=10 AND substr(a,3,1)=\'/\' AND substr(a,6,1)=\'/\' THEN substr(a,7,4)||\'-\'||substr(a,4,2)||\'-\'||substr(a,1,2) ELSE a END||\n CASE WHEN length(valor)=21 AND substr(valor,11,1)=\'/\' THEN \'/\'||CASE WHEN substr(b,3,1)=\'/\' AND substr(b,6,1)=\'/\' THEN substr(b,7,4)||\'-\'||substr(b,4,2)||\'-\'||substr(b,1,2) ELSE b END WHEN length(valor)>10 THEN substr(valor,11) ELSE \'\' END AS valor FROM extremos\n)\nUPDATE sc_planilha_itens AS i SET dados=json_set(dados,\'$.composicao\',coalesce((SELECT valor FROM normal WHERE linha=i.linha AND nome=\'composicao\'),\'\'),\'$.publicacao\',coalesce((SELECT valor FROM normal WHERE linha=i.linha AND nome=\'publicacao\'),\'\'))']
SQLiteAvancar[@Q26]
DefRecursoxQ27ySQLitePreparar[@Banco,l'WITH datas AS (\n SELECT i.linha,c.coluna,json_extract(i.dados,\'$.\'||c.nome) AS valor FROM sc_planilha_itens i,sc_planilha_campos c WHERE c.nome IN(\'composicao\',\'publicacao\')\n), limites AS (\n SELECT *,CASE length(valor) WHEN 4 THEN valor||\'-01-01\' WHEN 7 THEN valor||\'-01\' ELSE substr(valor,1,10) END AS inicio,\n CASE length(valor) WHEN 4 THEN valor||\'-12-31\' WHEN 7 THEN date(valor||\'-01\',\'+1 month\',\'-1 day\') WHEN 21 THEN substr(valor,12,10) ELSE valor END AS fim FROM datas\n)\nINSERT INTO sc_planilha_falhas SELECT linha,coluna,\'Data inválida: \'||valor FROM limites WHERE valor<>\'\' AND NOT coalesce(length(valor) IN(4,7,10,21) AND date(inicio,\'+0 days\')=inicio AND date(fim,\'+0 days\')=fim AND inicio<=fim AND substr(inicio,1,4)>=\'0001\' AND (length(valor)<>21 OR substr(valor,11,1)=\'/\'),0)']
SQLiteAvancar[@Q27]
DefRecursoxQ28ySQLitePreparar[@Banco,l'UPDATE sc_planilha_itens AS i SET contexto=json_object(\n \'ficha\',json_object(\'titulo\',coalesce(nullif(json_extract(dados,\'$.titulo\'),\'\'),\'Sem título\'),\'incipit\',coalesce(json_extract(dados,\'$.incipit\'),\'\'),\n \'corpus\',coalesce(nullif(json_extract(dados,\'$.corpus\'),\'\'),\'Fragmenta\'),\'genero\',coalesce(json_extract(dados,\'$.genero\'),\'\'),\'subgenero\',coalesce(json_extract(dados,\'$.subgenero\'),\'\'),\n \'estado\',coalesce(nullif(json_extract(dados,\'$.estado\'),\'\'),\'Rascunho\'),\'idioma\',coalesce(json_extract(dados,\'$.idioma\'),\'\'),\'autor\',coalesce(json_extract(dados,\'$.autor\'),\'\'),\n \'persona\',coalesce(json_extract(dados,\'$.persona\'),\'\'),\'certeza\',coalesce(nullif(json_extract(dados,\'$.certeza\'),\'\'),\'Indeterminado\'),\n \'composicao\',json_extract(dados,\'$.composicao\'),\'publicacao\',json_extract(dados,\'$.publicacao\'),\n \'tags\',json((SELECT json_group_array(valor) FROM sc_planilha_listas WHERE linha=i.linha AND campo=\'tags\')),\n \'colecoes\',json((SELECT json_group_array(valor) FROM sc_planilha_listas WHERE linha=i.linha AND campo=\'colecoes\')),\n \'justificativa\',coalesce(json_extract(dados,\'$.justificativa\'),\'\'),\'notas\',coalesce(json_extract(dados,\'$.notas\'),\'\'),\'arquivado\',json(\'false\'),\n \'importacao_planilha\',json_object(\'hash\',(SELECT hash FROM sc_planilha_meta),\'aba\',(SELECT aba FROM sc_planilha_meta),\'linha\',linha,\n \'arquivo_origem\',coalesce(json_extract(dados,\'$.arquivo_origem\'),\'\'),\'localizacao_origem\',coalesce(json_extract(dados,\'$.localizacao_origem\'),\'\'),\n \'corpus_sugerido\',coalesce(json_extract(dados,\'$.corpus_sugerido\'),\'\'),\'genero_sugerido\',coalesce(json_extract(dados,\'$.genero_sugerido\'),\'\'),\n \'tags_sugeridas\',coalesce(json_extract(dados,\'$.tags_sugeridas\'),\'\'),\'justificativa_ia\',coalesce(json_extract(dados,\'$.justificativa_ia\'),\'\'),\'sugestoes_aplicadas\',json(\'false\'))),\n \'fontes\',json(\'[]\'),\'origem\',0,\'motivo\',\'Importação de planilha revisada\')']
SQLiteAvancar[@Q28]
DefRecursoxQ29ySQLitePreparar[@Banco,l'UPDATE sc_planilha_itens AS i SET erro=coalesce((SELECT group_concat(\'Linha \'||f.linha||\', coluna \'||coalesce(c.referencia,\'?\')||\': \'||f.mensagem,char(10)) FROM sc_planilha_falhas f LEFT JOIN sc_planilha_celulas c ON c.linha=f.linha AND c.coluna=f.coluna WHERE f.linha=i.linha),\'\')']
SQLiteAvancar[@Q29]
DefRecursoxQ30ySQLitePreparar[@Banco,l'UPDATE sc_planilha_itens SET anterior=linha IN(SELECT json_extract(v.ficha,\'$.importacao_planilha.linha\') FROM versoes v,sc_planilha_meta m WHERE json_extract(v.ficha,\'$.importacao_planilha.hash\')=m.hash AND json_extract(v.ficha,\'$.importacao_planilha.aba\')=m.aba)']
SQLiteAvancar[@Q30]
DefRecursoxQ31ySQLitePreparar[@Banco,l'UPDATE sc_planilha_itens SET selecionada=(erro=\'\' AND anterior=0 AND (SELECT erro FROM sc_planilha_meta)=\'\')']
SQLiteAvancar[@Q31]
SQLiteTransacaoConfirmar[@Transacao]
FimFuncao

DefFuncaoxPlanilhaAplicarSugestoes[RefBancoSQLitexBanco,InSd64xLinha]yVazio
DefRecursoxQySQLitePreparar[@Banco,l'UPDATE sc_planilha_itens AS i SET contexto=json_set(contexto,\n \'$.ficha.corpus\',CASE WHEN coalesce(json_extract(dados,\'$.corpus\'),\'\')=\'\' THEN coalesce(nullif(json_extract(dados,\'$.corpus_sugerido\'),\'\'),json_extract(contexto,\'$.ficha.corpus\')) ELSE json_extract(contexto,\'$.ficha.corpus\') END,\n \'$.ficha.genero\',CASE WHEN coalesce(json_extract(dados,\'$.genero\'),\'\')=\'\' THEN coalesce(nullif(json_extract(dados,\'$.genero_sugerido\'),\'\'),json_extract(contexto,\'$.ficha.genero\')) ELSE json_extract(contexto,\'$.ficha.genero\') END,\n \'$.ficha.tags\',json((SELECT json_group_array(valor) FROM (SELECT DISTINCT valor FROM sc_planilha_listas WHERE linha=i.linha AND campo IN(\'tags\',\'tags_sugeridas\')))),\n \'$.ficha.importacao_planilha.sugestoes_aplicadas\',json(\'true\')),sugestoes=1\nWHERE erro=\'\' AND confirmada=0 AND sugestoes=0 AND ((?1=0 AND selecionada=1) OR linha=?1)\n']
SQLiteVincularInSd64[@Q,1,@Linha]
SQLiteAvancar[@Q]
FimFuncao
