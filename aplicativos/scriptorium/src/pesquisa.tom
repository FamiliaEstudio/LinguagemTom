// Gerado a partir de pesquisa.sql.
Importar[l'tom/sqlite']
DefFuncaoxAcervoPesquisar[RefBancoSQLitexBanco,TxtxFiltros,RefTextoxSaida]yVazio
DefRecursoxConsultaySQLitePreparar[@Banco,l'WITH f AS (SELECT json(?1) AS dados), candidatos AS MATERIALIZED (\n SELECT rowid AS id FROM pesquisa,f WHERE coalesce(json_extract(dados,\'$.busca\'),\'\')<>\'\' AND CAST(coalesce(json_extract(dados,\'$.exata\'),0) AS INTEGER)=0 AND pesquisa MATCH \'"\'||replace(json_extract(dados,\'$.busca\'),\'"\',\'""\')||\'"\'\n UNION ALL\n SELECT id FROM versoes,f WHERE coalesce(json_extract(dados,\'$.busca\'),\'\')=\'\' OR CAST(coalesce(json_extract(dados,\'$.exata\'),0) AS INTEGER)=1\n), filtrados AS MATERIALIZED (\n SELECT v.id,v.texto_id,v.titulo,v.persona,v.corpus,v.composicao,v.estado,v.criado FROM f CROSS JOIN candidatos c CROSS JOIN versoes v ON v.id=c.id CROSS JOIN textos t ON t.id=v.texto_id CROSS JOIN versoes atual ON atual.id=t.atual_id\n WHERE (CAST(coalesce(json_extract(dados,\'$.historico\'),0) AS INTEGER)=1 OR v.id=t.atual_id)\n AND atual.arquivado=CAST(coalesce(json_extract(dados,\'$.arquivados\'),0) AS INTEGER)\n AND (coalesce(json_extract(dados,\'$.corpus\'),\'\')=\'\' OR v.corpus=json_extract(dados,\'$.corpus\'))\n AND (coalesce(json_extract(dados,\'$.persona\'),\'\')=\'\' OR v.persona=json_extract(dados,\'$.persona\'))\n AND (coalesce(json_extract(dados,\'$.autor\'),\'\')=\'\' OR v.autor=json_extract(dados,\'$.autor\'))\n AND (coalesce(json_extract(dados,\'$.genero\'),\'\')=\'\' OR v.genero=json_extract(dados,\'$.genero\'))\n AND (coalesce(json_extract(dados,\'$.estado\'),\'\')=\'\' OR v.estado=json_extract(dados,\'$.estado\'))\n AND (CAST(coalesce(json_extract(dados,\'$.sem_persona\'),0) AS INTEGER)=0 OR v.persona=\'\')\n AND (coalesce(json_extract(dados,\'$.inicio\'),\'\')=\'\' OR v.data_fim>=json_extract(dados,\'$.inicio\'))\n AND (coalesce(json_extract(dados,\'$.fim\'),\'\')=\'\' OR v.data_inicio<=json_extract(dados,\'$.fim\'))\n AND (coalesce(json_extract(dados,\'$.tag\'),\'\')=\'\' OR EXISTS(SELECT 1 FROM versao_tags vt JOIN tags a ON a.id=vt.tag_id WHERE vt.versao_id=v.id AND a.nome=json_extract(dados,\'$.tag\')))\n AND (coalesce(json_extract(dados,\'$.colecao\'),\'\')=\'\' OR EXISTS(SELECT 1 FROM versao_colecoes vc JOIN colecoes a ON a.id=vc.colecao_id WHERE vc.versao_id=v.id AND a.nome=json_extract(dados,\'$.colecao\')))\n AND CASE WHEN coalesce(json_extract(dados,\'$.busca\'),\'\')=\'\' THEN 1\n WHEN CAST(coalesce(json_extract(dados,\'$.exata\'),0) AS INTEGER)=1 THEN tom_palavra_exata(v.conteudo,json_extract(dados,\'$.busca\'))+tom_palavra_exata(v.titulo,json_extract(dados,\'$.busca\'))>0\n ELSE 1 END\n)\nSELECT json_object(\'total\',(SELECT count(*) FROM filtrados),\'itens\',json(coalesce((\n SELECT json_group_array(json_object(\'id\',texto_id,\'versao\',id,\'titulo\',titulo,\'persona\',persona,\'corpus\',corpus,\'composicao\',composicao,\'estado\',estado,\'data\',criado))\n FROM(SELECT * FROM filtrados ORDER BY titulo COLLATE NOCASE,texto_id,id DESC LIMIT 50 OFFSET max(0,coalesce(json_extract(?1,\'$.pagina\'),0))*50)\n),\'[]\')))\n']
SQLiteVincularTexto[@Consulta,1,@Filtros]
SQLiteAvancar[@Consulta]
SQLiteColunaTexto[@Consulta,0,@Saida]
FimFuncao
