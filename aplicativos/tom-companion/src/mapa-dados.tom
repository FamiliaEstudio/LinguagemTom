DefVarInSd64xQuantidadey@ULTIMO
ParaxN[0,@Quantidade,1]
ChamarxMapaCaminho[l'/nodes/',@N,@Caminho]
// Até 3.000 caracteres Unicode, incluindo a memória do documento JSON.
DefRecursoxItemyJsonExtrair[@Bloco,@Caminho,65536]
JsonObterInSd64[@Item,l'/id']
DefVarInSd64xIdy@ULTIMO
ChamarxGrafoIndice[@Novos,@Id]
CompararIgualxyInSd64x@ULTIMOy-1
